# Port Configuration
PORT=3001

# Razorpay API Keys (Simulated/Future Production use)
RAZORPAY_KEY_ID=rzp_test_placeholder_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# SMS Gateway Configuration (Simulated/Future Production use)
SMS_API_KEY=sms_test_placeholder_key
SMS_SENDER_ID=FASTNET

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=fastnet-uploads
R2_PUBLIC_URL_BASE=https://pub-xxxxxxxx.r2.dev

# Email Service Configuration
EMAIL_MOCK=true
SENDGRID_API_KEY=your_sendgrid_key_when_ready
EMAIL_FROM_ADDRESS=noreply@fastnet.example
EMAIL_FROM_NAME=FastNet

# JWT Session Configuration
JWT_SECRET=change_me_in_prod_a_long_random_string

# Postgres Configuration
# For tests: use in-memory pg-mem
POSTGRES_MODE=mem

# For local dev or production against real Postgres:
# DATABASE_URL=postgresql://neondb_owner:...@...neon.tech/neondb?sslmode=require

# Seed Mode Configuration
# Options: production (default, seed nothing), test (used by regression suite)
SEED_MODE=production
